<!-- Live Activity & Event Log -->
<section class="activity-section card-glass">
    <div class="section-header">
        <div>
            <h2 class="section-title">Журнал подій системи, пристроїв та AI</h2>
            <p class="section-subtitle">Історія підключень пристроїв, спрацювань Workflow Engine та викликів MCP у реальному часі</p>
        </div>
        <button class="btn btn-ghost" @onclick="() => Monitor.ClearLogs()">Очистити журнал</button>
    </div>

    <div class="activity-log-list">
        @if (_logs.Count == 0)
        {
            <div class="empty-log">Журнал подій порожній.</div>
        }
        else
        {
            @foreach (var log in _logs.Take(15))
            {
                <div class="log-row @(log.IsError ? "log-error" : "log-info")">
                    <span class="log-time">@log.Timestamp.ToString("HH:mm:ss")</span>
                    <span class="log-device">@log.DeviceName</span>
