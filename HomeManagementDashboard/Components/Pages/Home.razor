@code {
    private string _activeTab = "dashboard";
    private IReadOnlyList<MonitoredDeviceState> _devices = Array.Empty<MonitoredDeviceState>();
    private IReadOnlyList<ActivityLogEntry> _logs = Array.Empty<ActivityLogEntry>();
    private IReadOnlyList<WorkflowRule> _rules = Array.Empty<WorkflowRule>();
    private IReadOnlyList<WorkflowExecutionLog> _workflowHistory = Array.Empty<WorkflowExecutionLog>();
    private IReadOnlyList<AiChatTurn> _aiChatTurns = Array.Empty<AiChatTurn>();

    private string _statusFilter = "all";
    private string _searchQuery = string.Empty;
    private bool _showAddDevice;
    private string _newDeviceName = string.Empty;
    private string _newDeviceUrl = string.Empty;
    private bool _isRefreshing;
    private bool _isDiscovering;
    private string? _statusBanner;

    // Workflow builder form state
    private string _wfName = "Авто-контроль температури";
    private WorkflowTriggerType _wfTriggerType = WorkflowTriggerType.TelemetryUpdate;
    private string _wfTriggerDevice = "Device1";
    private WorkflowMetricField _wfConditionField = WorkflowMetricField.TemperatureCelsius;
    private ComparisonOperator _wfConditionOp = ComparisonOperator.GreaterThan;
    private string _wfConditionValue = "43.5";
    private WorkflowActionType _wfActionType = WorkflowActionType.ExecuteDeviceAction;
    private string _wfActionDevice = "Device1";
    private string _wfActionCommand = "INFO";
    private int _wfCooldown = 30;

    // MCP & AI assistant state
    private string _aiPromptInput = string.Empty;
    private string _selectedMcpTool = "list_devices";
    private string _mcpToolArgsJson = "{\n  \"onlineOnly\": false\n}";
    private string? _mcpDirectResultJson;

    private string LocalIpAddress => NetworkManager.GetLocalIp();
    private int TotalCount => _devices.Count;
    private int OnlineCount => _devices.Count(d => d.IsOnline);
    private int OfflineCount => _devices.Count(d => !d.IsOnline);
    private double OnlinePercentage => TotalCount == 0 ? 0 : (double)OnlineCount / TotalCount * 100.0;

    private double AverageTemperature =>
        OnlineCount > 0 ? _devices.Where(d => d.IsOnline).Average(d => d.TemperatureCelsius) : 0;

    private double MinTemperature =>
        OnlineCount > 0 ? _devices.Where(d => d.IsOnline).Min(d => d.TemperatureCelsius) : 0;

    private double MaxTemperature =>
        OnlineCount > 0 ? _devices.Where(d => d.IsOnline).Max(d => d.TemperatureCelsius) : 0;

    private double ChartMinTemp
    {
        get
        {
            var pts = _devices.SelectMany(d => d.TemperatureHistory).Select(p => p.Value).ToList();
            return pts.Count > 0 ? Math.Floor(pts.Min() - 2) : 35;
        }
    }

    private double ChartMaxTemp
    {
        get
        {
            var pts = _devices.SelectMany(d => d.TemperatureHistory).Select(p => p.Value).ToList();
            var max = pts.Count > 0 ? Math.Ceiling(pts.Max() + 2) : 55;
            return Math.Max(ChartMinTemp + 4, max);
        }
    }

    private IEnumerable<MonitoredDeviceState> FilteredDevices =>
        _devices.Where(d =>
        {
            if (_statusFilter == "online" && !d.IsOnline) return false;
            if (_statusFilter == "offline" && d.IsOnline) return false;
            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.Trim();
                return d.EffectiveName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                       d.EndpointUrl.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                       (d.ReportedAddress?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false);
            }
            return true;
        });

    protected override void OnInitialized()
    {
        LoadSnapshot();
        Monitor.OnStateChanged += HandleStateChanged;
        Workflows.OnWorkflowStateChanged += HandleStateChanged;
        McpServer.OnMcpActivityChanged += HandleStateChanged;
    }

    private void LoadSnapshot()
    {
        _devices = Monitor.GetDevices();
        _logs = Monitor.GetActivityLogs();
        _rules = Workflows.GetRules();
        _workflowHistory = Workflows.GetExecutionHistory();
        _aiChatTurns = McpServer.GetChatHistory();
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(() =>
        {
            LoadSnapshot();
            StateHasChanged();
        });
    }

    private void ToggleAutoRefresh()
    {
        Monitor.AutoRefreshEnabled = !Monitor.AutoRefreshEnabled;
    }

    private async Task RefreshAllNowAsync()
    {
        _isRefreshing = true;
        try
        {
            await Monitor.RefreshAllAsync();
        }
        finally
        {
            _isRefreshing = false;
        }
    }

    private async Task DiscoverDevicesAsync()
    {
        _isDiscovering = true;
        try
        {
            var count = await Monitor.DiscoverLocalhostDevicesAsync();
            _statusBanner = count > 0
                ? $"Знайдено та підключено нових пристроїв: {count}"
                : "Нових активних пристроїв на стандартних локальних портах не знайдено.";
        }
        finally
        {
            _isDiscovering = false;
        }
    }

    private async Task AddCustomDeviceAsync()
    {
        if (string.IsNullOrWhiteSpace(_newDeviceUrl)) return;

        var added = await Monitor.AddDeviceAsync(_newDeviceUrl, string.IsNullOrWhiteSpace(_newDeviceName) ? null : _newDeviceName);
        if (added)
        {
            _statusBanner = $"Пристрій {_newDeviceUrl} додано до моніторингу.";
            _newDeviceName = string.Empty;
            _newDeviceUrl = string.Empty;
            _showAddDevice = false;
        }
        else
        {
            _statusBanner = "Цей пристрій вже є у списку моніторингу.";
        }
    }

    private async Task RunDeviceActionAsync(MonitoredDeviceState device, DeviceAction action)
    {
        await Monitor.ExecuteActionAsync(device, action);
    }

    private void CreateNewWorkflow()
    {
        if (string.IsNullOrWhiteSpace(_wfName)) return;

        Workflows.AddRule(new WorkflowRule
        {
            Name = _wfName.Trim(),
            Description = $"Тригер: {_wfTriggerDevice} • Кулдаун: {_wfCooldown}с",
            IsEnabled = true,
            TriggerType = _wfTriggerType,
            TriggerDeviceFilter = string.IsNullOrWhiteSpace(_wfTriggerDevice) ? "*" : _wfTriggerDevice.Trim(),
            CooldownSeconds = Math.Max(5, _wfCooldown),
            Condition = new WorkflowCondition
            {
                Field = _wfConditionField,
                Operator = _wfConditionOp,
                TargetValue = _wfConditionValue.Trim()
            },
            Action = new WorkflowActionDefinition
            {
                ActionType = _wfActionType,
                TargetDeviceNameOrUrl = string.IsNullOrWhiteSpace(_wfActionDevice) ? "Device1" : _wfActionDevice.Trim(),
                CommandOrActionName = string.IsNullOrWhiteSpace(_wfActionCommand) ? "INFO" : _wfActionCommand.Trim(),
                NotificationMessage = _wfActionType == WorkflowActionType.DashboardNotification ? _wfActionCommand.Trim() : null
            }
        });

        _statusBanner = $"Сценарій '{_wfName}' успішно створено!";
        LoadSnapshot();
    }

    private async Task RunWorkflowNowAsync(string id)
    {
        var (ok, output) = await Workflows.TriggerRuleManuallyAsync(id);
        _statusBanner = ok
            ? $"Сценарій виконано: {output}"
            : $"Помилка виконання сценарію: {output}";
        LoadSnapshot();
    }

    private async Task RunQuickAiPrompt(string prompt)
    {
        _aiPromptInput = prompt;
        await SendAiPromptAsync();
    }

    private async Task SendAiPromptAsync()
    {
        if (string.IsNullOrWhiteSpace(_aiPromptInput)) return;
        var prompt = _aiPromptInput;
        _aiPromptInput = string.Empty;
        await McpServer.ProcessNaturalLanguagePromptAsync(prompt);
        LoadSnapshot();
    }

    private void OnSelectedMcpToolChanged(ChangeEventArgs e)
    {
        _selectedMcpTool = e.Value?.ToString() ?? "list_devices";
        _mcpToolArgsJson = _selectedMcpTool switch
        {
            "discover_devices" => "{ }",
            "list_devices" => "{\n  \"onlineOnly\": false\n}",
            "get_device_details" => "{\n  \"device\": \"Device1\"\n}",
            "execute_device_action" => "{\n  \"device\": \"Device1\",\n  \"action\": \"Get Motion\"\n}",
            "list_workflows" => "{ }",
            "create_workflow" => "{\n  \"name\": \"MCP Temp Guard\",\n  \"triggerDevice\": \"Device1\",\n  \"metricField\": \"TemperatureCelsius\",\n  \"operator\": \"GreaterThan\",\n  \"threshold\": \"44.0\",\n  \"targetDevice\": \"Device1\",\n  \"actionCommand\": \"INFO\"\n}",
            "trigger_workflow" => "{\n  \"workflow\": \"wf-temp-guard\"\n}",
            _ => "{ }"
        };
    }

    private async Task InvokeSelectedMcpToolAsync()
    {
        JsonObject argsObj;
        try
        {
            argsObj = (JsonNode.Parse(_mcpToolArgsJson) as JsonObject) ?? new JsonObject();
        }
        catch (Exception ex)
        {
            _mcpDirectResultJson = $"Invalid JSON arguments: {ex.Message}";
            return;
        }

        var result = await McpServer.CallToolDirectAsync(_selectedMcpTool, argsObj);
        _mcpDirectResultJson = result.ToJsonString(new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        LoadSnapshot();
    }

    private static string GetSeriesColor(int index)
    {
        string[] palette = ["#38bdf8", "#34d399", "#a78bfa", "#fbbf24", "#f472b6"];
        return palette[index % palette.Length];
    }

    private static List<(double X, double Y)> GetSvgCoordinates(
        List<MetricSample> samples,
        double minX,
        double maxX,
        double minY,
        double maxY,
        double minVal,
        double maxVal)
    {
        var result = new List<(double X, double Y)>();
        if (samples.Count == 0) return result;

        var rangeVal = Math.Max(0.1, maxVal - minVal);
        for (int i = 0; i < samples.Count; i++)
        {
            var x = samples.Count == 1
                ? (minX + maxX) / 2.0
                : minX + (double)i / (samples.Count - 1) * (maxX - minX);
            var normalized = Math.Clamp((samples[i].Value - minVal) / rangeVal, 0.0, 1.0);
            var y = maxY - normalized * (maxY - minY);
            result.Add((x, y));
        }

        return result;
    }

    private static string BuildSvgPolylinePoints(
        List<MetricSample> samples,
        double minX,
        double maxX,
        double minY,
        double maxY,
        double minVal,
        double maxVal)
    {
        var coords = GetSvgCoordinates(samples, minX, maxX, minY, maxY, minVal, maxVal);
        return string.Join(" ", coords.Select(p => $"{p.X.ToString("0.0", CultureInfo.InvariantCulture)},{p.Y.ToString("0.0", CultureInfo.InvariantCulture)}"));
    }

    private static string BuildSvgAreaPoints(
        List<MetricSample> samples,
        double minX,
        double maxX,
        double minY,
        double maxY,
        double minVal,
        double maxVal)
    {
        var coords = GetSvgCoordinates(samples, minX, maxX, minY, maxY, minVal, maxVal);
        if (coords.Count == 0) return string.Empty;
        var poly = BuildSvgPolylinePoints(samples, minX, maxX, minY, maxY, minVal, maxVal);
        var firstX = coords.First().X.ToString("0.0", CultureInfo.InvariantCulture);
        var lastX = coords.Last().X.ToString("0.0", CultureInfo.InvariantCulture);
        var bottomY = maxY.ToString("0.0", CultureInfo.InvariantCulture);
        return $"{firstX},{bottomY} {poly} {lastX},{bottomY}";
    }

    public void Dispose()
    {
        Monitor.OnStateChanged -= HandleStateChanged;
        Workflows.OnWorkflowStateChanged -= HandleStateChanged;
        McpServer.OnMcpActivityChanged -= HandleStateChanged;
    }
}
